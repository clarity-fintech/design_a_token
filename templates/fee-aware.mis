# CDK starter — fee-aware Token Extension (.mis)

module CLRTY.TokenExtensions.FeeAware {

  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant fee_bps_bound: transfer_fee_bps <= 1000;

  outcome fn_init(ctx: Bytes) {
    require ctx != @0;
    constraint owner_initialized == true;
    constraint transfer_fee_config_enabled == true;
  }

  outcome fn_transfer(ctx: Bytes) {
    require ctx != @0;
    constraint amount_positive == true;
    constraint fee_collected == true;
  }
}
